{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: aktuální soubor",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: FastAPI (bez reloadu)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/python",
      "console": "integratedTerminal"
    }
  ]
}
